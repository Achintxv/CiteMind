# PostgreSQL with the pgvector extension installed
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/minirag?schema=public"


# Get a key at https://aistudio.google.com/apikey  (server-side only, never NEXT_PUBLIC_)
GEMINI_API_KEY=your_api_key

GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# MUST equal the vector(N) size in prisma/schema.prisma and the migration (768 by default).
EMBEDDING_DIMENSIONS=768

# Bytes (5 MB)
MAX_FILE_SIZE=5242880

# Measured in ESTIMATED tokens (about 4 characters per token)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

TOP_K=3
# Minimum cosine SIMILARITY (1 - cosine distance), range -1..1. Tune for your documents.
SIMILARITY_THRESHOLD=0.5
